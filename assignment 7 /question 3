function Student(name, marks) {
    this.name = name;
    this.marks = marks;
}

Student.prototype.result = function() {
    if (this.marks >= 40) {
        return "Pass";
    }
    else {
        return "Fail";
    }
};

const student = new Student("Asha", 88);

console.log(student.result());
